Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Cell Size: 5
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Target (ground truth)
      Topic:
        Value: /target_marker
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Radar measurements
      Topic:
        Value: /radar/measurement_markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Estimator
      Topic:
        Value: /estimator/markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Interceptor
      Topic:
        Value: /interceptor/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 90
      Pitch: 0.25
      Yaw: 4.7
      Focal Point:
        X: 25
        Y: 0
        Z: 15
