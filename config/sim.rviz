Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    # Faint reference grid, lifted just above the ground plane so the two
    # surfaces do not fight over the same pixels.
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Cell Size: 10
      Alpha: 0.3
      Color: 130; 130; 130
      Offset:
        X: 0
        Y: 0
        Z: 0.05
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: World (ground, city, radar, launcher)
      Topic:
        Value: /world_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Target + trail + ground explosion
      Topic:
        Value: /target/markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Radar measurements
      Topic:
        Value: /radar/measurement_markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Estimator (estimate, prediction, impact)
      Topic:
        Value: /estimator/markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Interceptor + trail + air explosion
      Topic:
        Value: /interceptor/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
    Background Color: 25; 30; 40
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 150
      Pitch: 0.30
      Yaw: 4.6
      Focal Point:
        X: 42
        Y: 0
        Z: 18
